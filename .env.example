# All optional — features hide gracefully when unset.

# realtemp-api Worker origin (worker/ in this repo; deploy with `npm run deploy` there).
# Enables: one-tap street reports + LLM copy line.
VITE_API_BASE=

# Sentry DSN from sentry.io project settings. Enables crash reporting (card N6b).
VITE_SENTRY_DSN=
