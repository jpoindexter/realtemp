{
  "name": "realtemp-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 4 * * *"] },
  "vars": { "VAPID_PUBLIC_KEY": "BF8MfrxJ_cCc0KT0T0L_F0-YwZZ_1L4Q4YRB8ZCGNvcKmb4b9r3JUqjwopgBEYbfX2pjU0YnqJtk8en7nSvad0I" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "realtemp-app",
      // Used for push subscriptions and any future app tables.
      // Jason: create with `wrangler d1 create realtemp-app`, paste the id here,
      // then run `wrangler d1 execute realtemp-app --file schema.sql --remote`
      "database_id": "7a29c49b-ba4c-4cbc-9b55-7d771b497e5d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      // Jason: `wrangler kv namespace create CACHE`, paste the id
      "id": "8ba4b68870df4dde9c2aa92353ed7d24"
    }
  ]
  // Secret (optional, enables /api/copy LLM path): `wrangler secret put ANTHROPIC_API_KEY`
}
